<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Fixflow" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Core Dark Colors -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorContainer">@color/card_dark</item>
        <item name="colorOnContainer">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar and navigation bar styling -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.Fixflow" parent="Base.Theme.Fixflow" />
</resources>
