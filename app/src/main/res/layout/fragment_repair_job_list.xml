<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_repair_jobs"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_repair_jobs"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Search Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_search_jobs"
        app:boxStrokeColor="@color/primary_accent"
        app:endIconMode="clear_text"
        app:hintTextColor="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Horizontal Status Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/chip_all"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_received"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_received"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_diagnosing"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_diagnosing"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_awaiting_approval"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_awaiting_approval"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_repairing"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_repairing"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_testing"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_testing"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_completed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_completed"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_awaiting_collection"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/metric_awaiting_collection"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_overdue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overdue"
                android:textColor="@color/status_rejected" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rejected"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_rejected"
                android:textColor="@color/text_primary" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Jobs RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_jobs_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_empty_jobs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/empty_jobs_msg"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
